@model List<User>
@{
    Layout = "_mainLayout";
}
<div class="container mt-5">
    @section heading {
        <div class="card-header text-center">
            <h3 class="mt-3">Create User</h3>
        </div>
    }

    @if (!Model.Any())
    {
        <h2 class="text-center">No user found</h2>
    }
    else
    {
        @foreach (var user in Model)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">

                    <h5 class="card-title">@user.Name</h5>

                    <p class="card-text">
                        <strong>Email:</strong> @user.City
                    </p>

                    <p class="card-text">
                        <strong>Score:</strong> @user.Age
                    </p>
                    <div>
                        <a href="/Users/Edit/@user.Id" class="btn btn-warning">Edit</a>
                        <form method="post" action="/Users/Delete/@user.Id" style="display:inline;">
                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        }
    }

</div>